      <dc:subject>
        <rdf:Bag>
          <rdf:li>ImÃ¡genes mÃ©dicas</rdf:li>
          <rdf:li>Tratamiento de imÃ¡genes mÃ©dicas</rdf:li>
          <rdf:li>CÃ¡ncer de mama</rdf:li>
